# 环境变量模板
# 复制为 .env 后填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交；本模板会提交，供其他人参考。

# DeepSeek 大模型 API Key，用于商品标签抽取
# 留空时系统仍可运行，标签抽取自动降级为词典规则（source=RULE）
LLM_API_KEY=

# 前端对外端口（可选，默认 80）
# 若本机 80 被其它程序占用（例如课程环境自带的 Nginx），改成 8000 等空闲端口，
# 之后访问 http://localhost:8000
# FRONTEND_PORT=8000

# 可选：覆盖默认接口地址与模型
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
